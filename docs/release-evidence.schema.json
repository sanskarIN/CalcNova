{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanskarIN/CalcNova/blob/main/docs/release-evidence.schema.json",
  "title": "CalcNova Release Validation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "commit", "generatedAtUtc", "host", "checks"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["PASS", "FAIL", "NOT RUN", "BLOCKED"]
          },
          "command": {"type": "string", "minLength": 1},
          "exitCode": {"type": "integer"},
          "reason": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "minimum": 0},
          "logFile": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
