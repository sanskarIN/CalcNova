<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <!-- Android 12 and later: the theme from values/styles.xml plus the splash-screen
       attributes that only exist from API 31. The AppCompat parent requirement described
       in values/styles.xml applies here too. -->
  <style name="CalcNovaTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:navigationBarColor">@color/calcnova_icon_background</item>
    <item name="android:statusBarColor">@color/calcnova_icon_background</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowSplashScreenBackground">@color/calcnova_splash_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="android:windowSplashScreenAnimationDuration">0</item>
  </style>
</resources>
