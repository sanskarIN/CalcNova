<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Short confirmation buzzes for calculator input, gated behind the Haptics preference.
       VIBRATE is a normal permission: it is granted at install and never prompts. -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!-- Declared so CalcNova installs on devices without a vibrator instead of being filtered out
       of the store listing; the haptic service degrades to doing nothing on those devices. -->
  <uses-feature android:name="android.hardware.vibrate" android:required="false" />

  <application
      android:label="@string/app_name"
      android:allowBackup="true"
      android:supportsRtl="true"
      android:theme="@style/CalcNovaTheme"
      android:usesCleartextTraffic="false"
      android:enableOnBackInvokedCallback="true"
      android:localeConfig="@xml/locales_config"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules" />
</manifest>
