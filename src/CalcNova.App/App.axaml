<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalcNova.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="52" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style Selector="Button.calc-key">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style Selector="Button.function-key">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="3" />
    </Style>

    <Style Selector="UserControl.compact Button">
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="UserControl.compact Button.calc-key">
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="UserControl.compact Button.function-key">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="UserControl.compact TextBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="UserControl.compact ComboBox">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="UserControl.compact TabItem">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="UserControl.medium TabItem">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="UserControl.expanded TabItem">
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </Application.Styles>
</Application>
