<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalcNova.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.calc-key">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style Selector="Button.function-key">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style Selector=":is(UserControl).high-contrast Button">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector=":is(UserControl).high-contrast TextBox">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector=":is(UserControl).high-contrast ComboBox">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector=":is(UserControl).high-contrast ListBox">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Application.Styles>
</Application>
