<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CalcNova.App.ViewModels"
             x:Class="CalcNova.App.Views.OnboardingOverlay"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding Settings.ShouldShowOnboarding}">
  <!-- The card paints its own fixed light surface, so its two actions have to carry their own
       colours as well. Left to the theme they follow the app's variant, and on a device in dark
       mode that puts near-white button text on this near-white card: the actions are still there
       and still tappable, but invisible, which reads exactly like onboarding having no way out.

       BorderThickness is deliberately not set here, so the focus indicator in App.axaml still
       thickens the border when the button is focused. -->
  <UserControl.Styles>
    <Style Selector="Button.onboarding-action">
      <Setter Property="Background" Value="#FFE2E8F0" />
      <Setter Property="Foreground" Value="#FF111827" />
      <Setter Property="BorderBrush" Value="#FF94A3B8" />
    </Style>
    <Style Selector="Button.onboarding-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFCBD5E1" />
      <Setter Property="TextBlock.Foreground" Value="#FF111827" />
    </Style>
    <Style Selector="Button.onboarding-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFB4C0D0" />
      <Setter Property="TextBlock.Foreground" Value="#FF111827" />
    </Style>

    <Style Selector="Button.onboarding-primary">
      <Setter Property="Background" Value="#FF1D4ED8" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#FF1D4ED8" />
    </Style>
    <Style Selector="Button.onboarding-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF1A43B8" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.onboarding-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF16389B" />
      <Setter Property="TextBlock.Foreground" Value="#FFFFFFFF" />
    </Style>
  </UserControl.Styles>
  <Border Background="#CC000000" Padding="16">
    <!-- The card stretches rather than centring, so it can never be taller than the space it
         has. A card that centres inside a ScrollViewer is measured against the viewport and
         clipped instead of scrolled, and on a short phone that cut off the bottom of the card -
         which is where Skip and Start calculating used to live, leaving no way out of
         onboarding at all.

         Skip and Start calculating are now outside the ScrollViewer, in their own Auto row, so
         the grid gives them their height first and the prose takes whatever is left. They stay
         on screen at any height, however little room the text has. -->
    <Border MaxWidth="640"
            MaxHeight="760"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="#FFF8FAFD"
            BorderBrush="#FF596780"
            BorderThickness="1"
            CornerRadius="18">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock Text="Welcome to CalcNova"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#FF111827"
                       TextWrapping="Wrap" />
            <TextBlock Text="Fast. Precise. Private. Everywhere."
                       FontSize="17"
                       Foreground="#FF334155"
                       TextWrapping="Wrap" />

            <Border Background="#FFE8EEF7" Padding="14" CornerRadius="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Calculate your way"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF111827"
                           TextWrapping="Wrap" />
                <TextBlock Text="Use standard and scientific calculation, Programmer, Converter, Statistics, Equations, Matrices, Graphing, Date &amp; Duration, Currency, and History from one shared workspace."
                           Foreground="#FF334155"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="#FFE8EEF7" Padding="14" CornerRadius="12">
              <StackPanel Spacing="8">
                <!-- These headings wrap because they are longer than a narrow phone card is
                     wide; without it the end of the heading is simply cut off. -->
                <TextBlock Text="Keyboard and touch friendly"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF111827"
                           TextWrapping="Wrap" />
                <TextBlock Text="On keyboard targets, Ctrl+PageUp and Ctrl+PageDown cycle through modes; Ctrl+Home and Ctrl+End jump to the first and last modes. Calculator number-pad input is supported when you are not editing a text field."
                           Foreground="#FF334155"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="#FFE8EEF7" Padding="14" CornerRadius="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Local-first by default"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF111827"
                           TextWrapping="Wrap" />
                <TextBlock Text="Calculation history and preferences stay in local app storage. Physical unit conversion is offline. Currency rates are the optional network-enhanced feature and can use cached data when available."
                           Foreground="#FF334155"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock Text="No account is required for core CalcNova features. You can skip this introduction immediately."
                       Foreground="#FF475569"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Content="Skip"
                  Classes="onboarding-action"
                  Command="{Binding Settings.SkipOnboardingCommand}"
                  AutomationProperties.Name="Skip CalcNova introduction"
                  Margin="0,0,8,0" />
          <Button Content="Start calculating"
                  Classes="onboarding-action onboarding-primary"
                  Command="{Binding Settings.CompleteOnboardingCommand}"
                  AutomationProperties.Name="Complete CalcNova introduction and start calculating"
                  Margin="0,0,0,0" />
        </WrapPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
