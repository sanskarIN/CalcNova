<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modes="using:CalcNova.App.Views.Modes"
             x:Class="CalcNova.App.Views.MainView"
             AttachedToVisualTree="OnAttachedToVisualTree"
             DetachedFromVisualTree="OnDetachedFromVisualTree"
             KeyDown="OnKeyDown"
             PointerPressed="OnPointerPressed">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="CalcNova" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Fast. Precise. Private. Everywhere." Opacity="0.68" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
        <TextBlock Text="Local-first" HorizontalAlignment="Right" Opacity="0.62" />
        <TextBlock Text="Apache-2.0 • Open source" HorizontalAlignment="Right" Opacity="0.48" />
        <Button Content="Shortcuts"
                HorizontalAlignment="Right"
                Padding="10,4"
                ToolTip.Tip="Show calculator keyboard shortcuts">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Padding="14" MaxWidth="420">
                <StackPanel Spacing="8">
                  <TextBlock Text="Keyboard shortcuts" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="These shortcuts apply when Calc mode is active and a text field does not own the keystroke." TextWrapping="Wrap" Opacity="0.65" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                    <TextBlock Text="Enter" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Evaluate / repeat equals" />
                    <TextBlock Grid.Row="1" Text="Esc" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Clear calculator" />
                    <TextBlock Grid.Row="2" Text="Backspace" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Delete last calculator character" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="F9" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle positive / negative" />
                    <TextBlock Grid.Row="4" Text="Ctrl/Cmd+C" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Copy calculator result" />
                    <TextBlock Grid.Row="5" Text="Ctrl/Cmd+V" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Paste a bounded expression" />
                    <TextBlock Grid.Row="6" Text="0–9 + − × ÷" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Type calculator digits/operators, including numpad" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
      <TabItem Header="Calc">
        <modes:CalculatorModeView DataContext="{Binding Calculator}" />
      </TabItem>
      <TabItem Header="Prog">
        <modes:ProgrammerModeView DataContext="{Binding Programmer}" />
      </TabItem>
      <TabItem Header="Convert">
        <modes:ConverterModeView DataContext="{Binding Converter}" />
      </TabItem>
      <TabItem Header="Stats">
        <modes:StatisticsModeView DataContext="{Binding Statistics}" />
      </TabItem>
      <TabItem Header="Eq">
        <modes:EquationsModeView DataContext="{Binding Equations}" />
      </TabItem>
      <TabItem Header="Matrix">
        <modes:MatricesModeView DataContext="{Binding Matrices}" />
      </TabItem>
      <TabItem Header="Graph">
        <modes:GraphingModeView DataContext="{Binding Graphing}" />
      </TabItem>
      <TabItem Header="Date">
        <modes:DateTimeModeView DataContext="{Binding DateTime}" />
      </TabItem>
      <TabItem Header="FX">
        <modes:CurrencyModeView DataContext="{Binding Currency}" />
      </TabItem>
      <TabItem Header="History">
        <modes:HistoryModeView DataContext="{Binding History}" />
      </TabItem>
      <TabItem Header="Settings">
        <modes:SettingsModeView DataContext="{Binding Settings}" />
      </TabItem>
      <TabItem Header="About">
        <modes:AboutModeView DataContext="{Binding About}" />
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2"
               Text="Calculations stay local by default • github.com/sanskarIN/CalcNova"
               HorizontalAlignment="Center"
               Margin="0,8,0,0"
               Opacity="0.5" />
  </Grid>
</UserControl>
