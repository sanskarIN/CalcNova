<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalcNova.App.Views.MainView"
             AttachedToVisualTree="OnAttachedToVisualTree"
             DetachedFromVisualTree="OnDetachedFromVisualTree"
             KeyDown="OnKeyDown">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="CalcNova" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Fast. Precise. Private. Everywhere." Opacity="0.68" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="Local-first" VerticalAlignment="Center" Opacity="0.55" />
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
      <TabItem Header="Calc">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Calculator}" Margin="6" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Standard + Scientific" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Safe local expression evaluation" Opacity="0.62" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding AngleModeLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
            <Border Padding="12" CornerRadius="14">
              <StackPanel Spacing="6">
                <TextBox Text="{Binding Expression, Mode=TwoWay}" Watermark="Enter an expression" FontSize="19" HorizontalContentAlignment="Right" />
                <Button Command="{Binding UseResultCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Right">
                  <TextBlock Text="{Binding Result}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.75" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*,*">
              <Button Content="DEG" Command="{Binding SetAngleUnitCommand}" CommandParameter="Degrees" Margin="2" />
              <Button Grid.Column="1" Content="RAD" Command="{Binding SetAngleUnitCommand}" CommandParameter="Radians" Margin="2" />
              <Button Grid.Column="2" Content="GRAD" Command="{Binding SetAngleUnitCommand}" CommandParameter="Gradians" Margin="2" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*,*">
              <Button Content="MC" Command="{Binding MemoryClearCommand}" Margin="2" />
              <Button Grid.Column="1" Content="MR" Command="{Binding MemoryRecallCommand}" Margin="2" />
              <Button Grid.Column="2" Content="MS" Command="{Binding MemoryStoreCommand}" Margin="2" />
              <Button Grid.Column="3" Content="M+" Command="{Binding MemoryAddCommand}" Margin="2" />
              <Button Grid.Column="4" Content="M−" Command="{Binding MemorySubtractCommand}" Margin="2" />
            </Grid>
            <TextBlock Text="{Binding MemoryIndicator}" HorizontalAlignment="Right" Opacity="0.6" />
            <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto,Auto">
              <Button Classes="function-key" Content="sin" Command="{Binding AppendCommand}" CommandParameter="sin(" />
              <Button Classes="function-key" Grid.Column="1" Content="cos" Command="{Binding AppendCommand}" CommandParameter="cos(" />
              <Button Classes="function-key" Grid.Column="2" Content="tan" Command="{Binding AppendCommand}" CommandParameter="tan(" />
              <Button Classes="function-key" Grid.Column="3" Content="ln" Command="{Binding AppendCommand}" CommandParameter="ln(" />
              <Button Classes="function-key" Grid.Column="4" Content="log" Command="{Binding AppendCommand}" CommandParameter="log10(" />
              <Button Classes="function-key" Grid.Row="1" Content="√" Command="{Binding AppendCommand}" CommandParameter="sqrt(" />
              <Button Classes="function-key" Grid.Row="1" Grid.Column="1" Content="x²" Command="{Binding AppendCommand}" CommandParameter="sqr(" />
              <Button Classes="function-key" Grid.Row="1" Grid.Column="2" Content="xʸ" Command="{Binding AppendCommand}" CommandParameter="^" />
              <Button Classes="function-key" Grid.Row="1" Grid.Column="3" Content="π" Command="{Binding AppendCommand}" CommandParameter="pi" />
              <Button Classes="function-key" Grid.Row="1" Grid.Column="4" Content="e" Command="{Binding AppendCommand}" CommandParameter="e" />
              <Button Classes="function-key" Grid.Row="2" Content="(" Command="{Binding AppendCommand}" CommandParameter="(" />
              <Button Classes="function-key" Grid.Row="2" Grid.Column="1" Content=")" Command="{Binding AppendCommand}" CommandParameter=")" />
              <Button Classes="function-key" Grid.Row="2" Grid.Column="2" Content="%" Command="{Binding PercentageCommand}" />
              <Button Classes="function-key" Grid.Row="2" Grid.Column="3" Content="fact" Command="{Binding AppendCommand}" CommandParameter="factorial(" />
              <Button Classes="function-key" Grid.Row="2" Grid.Column="4" Content="1/x" Command="{Binding AppendCommand}" CommandParameter="reciprocal(" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <Button Classes="calc-key" Content="AC" Command="{Binding ClearCommand}" />
              <Button Classes="calc-key" Grid.Column="1" Content="⌫" Command="{Binding BackspaceCommand}" />
              <Button Classes="calc-key" Grid.Column="2" Content="÷" Command="{Binding AppendCommand}" CommandParameter="/" />
              <Button Classes="calc-key" Grid.Column="3" Content="×" Command="{Binding AppendCommand}" CommandParameter="*" />
              <Button Classes="calc-key" Grid.Row="1" Content="7" Command="{Binding AppendCommand}" CommandParameter="7" />
              <Button Classes="calc-key" Grid.Row="1" Grid.Column="1" Content="8" Command="{Binding AppendCommand}" CommandParameter="8" />
              <Button Classes="calc-key" Grid.Row="1" Grid.Column="2" Content="9" Command="{Binding AppendCommand}" CommandParameter="9" />
              <Button Classes="calc-key" Grid.Row="1" Grid.Column="3" Content="−" Command="{Binding AppendCommand}" CommandParameter="-" />
              <Button Classes="calc-key" Grid.Row="2" Content="4" Command="{Binding AppendCommand}" CommandParameter="4" />
              <Button Classes="calc-key" Grid.Row="2" Grid.Column="1" Content="5" Command="{Binding AppendCommand}" CommandParameter="5" />
              <Button Classes="calc-key" Grid.Row="2" Grid.Column="2" Content="6" Command="{Binding AppendCommand}" CommandParameter="6" />
              <Button Classes="calc-key" Grid.Row="2" Grid.Column="3" Content="+" Command="{Binding AppendCommand}" CommandParameter="+" />
              <Button Classes="calc-key" Grid.Row="3" Content="1" Command="{Binding AppendCommand}" CommandParameter="1" />
              <Button Classes="calc-key" Grid.Row="3" Grid.Column="1" Content="2" Command="{Binding AppendCommand}" CommandParameter="2" />
              <Button Classes="calc-key" Grid.Row="3" Grid.Column="2" Content="3" Command="{Binding AppendCommand}" CommandParameter="3" />
              <Button Classes="calc-key" Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Content="=" Command="{Binding EvaluateCommand}" />
              <Button Classes="calc-key" Grid.Row="4" Grid.ColumnSpan="2" Content="0" Command="{Binding AppendCommand}" CommandParameter="0" />
              <Button Classes="calc-key" Grid.Row="4" Grid.Column="2" Content="." Command="{Binding AppendCommand}" CommandParameter="." />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Prog">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Programmer}" Margin="8" Spacing="10">
            <TextBlock Text="Programmer Calculator" FontSize="21" FontWeight="SemiBold" />
            <TextBox Text="{Binding Input, Mode=TwoWay}" Watermark="Value" />
            <TextBlock Text="Input radix" Opacity="0.62" />
            <ComboBox ItemsSource="{Binding CommonBases}" SelectedItem="{Binding InputBase, Mode=TwoWay}" />
            <TextBlock Text="Word size" Opacity="0.62" />
            <ComboBox ItemsSource="{Binding WordSizes}" SelectedItem="{Binding WordSize, Mode=TwoWay}" />
            <CheckBox Content="Signed two's-complement interpretation" IsChecked="{Binding Signed, Mode=TwoWay}" />
            <Button Content="Convert" Command="{Binding ConvertCommand}" HorizontalAlignment="Left" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="BIN" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Binary}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="OCT" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Octal}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="DEC" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Decimal}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="HEX" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Hexadecimal}" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Text="Fixed-width bit pattern" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BitPattern}" TextWrapping="Wrap" />
            <TextBlock Text="Quick-toggle low byte (b7 … b0)" Opacity="0.62" />
            <WrapPanel>
              <Button Content="b7" Command="{Binding ToggleBitCommand}" CommandParameter="7" Margin="0,0,6,6" />
              <Button Content="b6" Command="{Binding ToggleBitCommand}" CommandParameter="6" Margin="0,0,6,6" />
              <Button Content="b5" Command="{Binding ToggleBitCommand}" CommandParameter="5" Margin="0,0,6,6" />
              <Button Content="b4" Command="{Binding ToggleBitCommand}" CommandParameter="4" Margin="0,0,6,6" />
              <Button Content="b3" Command="{Binding ToggleBitCommand}" CommandParameter="3" Margin="0,0,6,6" />
              <Button Content="b2" Command="{Binding ToggleBitCommand}" CommandParameter="2" Margin="0,0,6,6" />
              <Button Content="b1" Command="{Binding ToggleBitCommand}" CommandParameter="1" Margin="0,0,6,6" />
              <Button Content="b0" Command="{Binding ToggleBitCommand}" CommandParameter="0" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="Interpreted value" FontWeight="SemiBold" />
            <TextBlock Text="{Binding InterpretedValue}" FontSize="19" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Code">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding CodePoint}" Margin="8" Spacing="10">
            <TextBlock Text="Unicode Code Points" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Inspect Unicode scalars without splitting supplementary characters into UTF-16 units." Opacity="0.62" TextWrapping="Wrap" />
            <TextBlock Text="Code point to text" FontWeight="SemiBold" />
            <TextBox Text="{Binding CodePointInput, Mode=TwoWay}" Watermark="U+0041 or U+1F600" />
            <Button Content="Decode code point" Command="{Binding DecodeCodePointCommand}" HorizontalAlignment="Left" />
            <Border Padding="10" CornerRadius="10"><TextBlock Text="{Binding CodePointResult}" FontSize="20" TextWrapping="Wrap" /></Border>
            <TextBlock Text="Text to code points" FontWeight="SemiBold" />
            <TextBox Text="{Binding TextInput, Mode=TwoWay}" Watermark="Text to inspect" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" />
            <Button Content="Inspect text" Command="{Binding InspectTextCommand}" HorizontalAlignment="Left" />
            <Border Padding="10" CornerRadius="10"><TextBlock Text="{Binding TextResult}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Convert">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Converter}" Margin="8" Spacing="10">
            <TextBlock Text="Offline Unit Converter" FontSize="21" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
            <ComboBox ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding FromUnit, Mode=TwoWay}" />
            <Button Content="Swap units" Command="{Binding SwapCommand}" HorizontalAlignment="Left" />
            <ComboBox ItemsSource="{Binding AvailableUnits}" SelectedItem="{Binding ToUnit, Mode=TwoWay}" />
            <TextBox Text="{Binding Input, Mode=TwoWay}" Watermark="Input value" />
            <TextBlock Text="Significant digits" Opacity="0.62" />
            <ComboBox ItemsSource="{Binding PrecisionOptions}" SelectedItem="{Binding SignificantDigits, Mode=TwoWay}" />
            <WrapPanel>
              <Button Content="Convert" Command="{Binding ConvertCommand}" Margin="0,0,6,6" />
              <Button Content="{Binding FavoriteToggleLabel}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Result}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Recent pairs" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding RecentPairs}" SelectedItem="{Binding SelectedPair, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Favorite pairs" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding FavoritePairs}" SelectedItem="{Binding SelectedPair, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Stats">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Statistics}" Margin="8" Spacing="10">
            <TextBlock Text="Statistics" FontSize="21" FontWeight="SemiBold" />
            <TextBox Text="{Binding DatasetText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap" />
            <Button Content="Analyze" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Left" />
            <Border Padding="12" CornerRadius="12"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Eq">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Equations}" Margin="8" Spacing="10">
            <TextBlock Text="Equation Solver" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Solve ax² + bx + c = 0" Opacity="0.62" />
            <TextBox Text="{Binding A, Mode=TwoWay}" Watermark="a" />
            <TextBox Text="{Binding B, Mode=TwoWay}" Watermark="b" />
            <TextBox Text="{Binding C, Mode=TwoWay}" Watermark="c" />
            <Button Content="Solve" Command="{Binding SolveCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Result}" FontSize="19" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Matrix">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Matrices}" Margin="8" Spacing="10">
            <TextBlock Text="Matrix Utilities" FontSize="21" FontWeight="SemiBold" />
            <TextBox Text="{Binding MatrixText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="130" />
            <TextBox Text="{Binding RightHandSideText, Mode=TwoWay}" Watermark="Right-hand side b" />
            <WrapPanel>
              <Button Content="det" Command="{Binding DeterminantCommand}" Margin="0,0,6,6" />
              <Button Content="inverse" Command="{Binding InverseCommand}" Margin="0,0,6,6" />
              <Button Content="rank" Command="{Binding RankCommand}" Margin="0,0,6,6" />
              <Button Content="solve" Command="{Binding SolveCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Graph">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Graphing}" Margin="8" Spacing="10">
            <TextBlock Text="Graphing" FontSize="21" FontWeight="SemiBold" />
            <TextBox Text="{Binding Expression, Mode=TwoWay}" Watermark="y = f(x)" />
            <TextBox Text="{Binding MinimumX, Mode=TwoWay}" Watermark="Minimum x" />
            <TextBox Text="{Binding MaximumX, Mode=TwoWay}" Watermark="Maximum x" />
            <TextBox Text="{Binding SampleCount, Mode=TwoWay}" Watermark="Sample count" />
            <Button Content="Plot / sample" Command="{Binding PlotCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Padding="10" CornerRadius="10"><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="Numerical analysis (approximate)" FontWeight="SemiBold" />
            <TextBox Text="{Binding AnalysisX, Mode=TwoWay}" Watermark="x for derivative" />
            <WrapPanel>
              <Button Content="Derivative at x" Command="{Binding DerivativeCommand}" Margin="0,0,6,6" />
              <Button Content="Find root in range" Command="{Binding FindRootCommand}" Margin="0,0,6,6" />
              <Button Content="Integrate over range" Command="{Binding IntegrateCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <Border Padding="10" CornerRadius="10"><TextBlock Text="{Binding AnalysisResult}" FontSize="18" TextWrapping="Wrap" /></Border>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Date">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding DateTime}" Margin="8" Spacing="10">
            <TextBlock Text="Date &amp; Duration Utilities" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Dates use yyyy-MM-dd. Calendar arithmetic is timezone-free." Opacity="0.62" TextWrapping="Wrap" />
            <TextBlock Text="Start date" />
            <TextBox Text="{Binding StartDate, Mode=TwoWay}" Watermark="yyyy-MM-dd" />
            <TextBlock Text="End date" />
            <TextBox Text="{Binding EndDate, Mode=TwoWay}" Watermark="yyyy-MM-dd" />
            <Button Content="Calculate difference" Command="{Binding CalculateDifferenceCommand}" HorizontalAlignment="Left" />
            <Border Padding="10" CornerRadius="10"><TextBlock Text="{Binding DifferenceResult}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="Add to start date" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*,*,*">
              <TextBox Text="{Binding Years, Mode=TwoWay}" Watermark="Years" Margin="2" />
              <TextBox Grid.Column="1" Text="{Binding Months, Mode=TwoWay}" Watermark="Months" Margin="2" />
              <TextBox Grid.Column="2" Text="{Binding Weeks, Mode=TwoWay}" Watermark="Weeks" Margin="2" />
              <TextBox Grid.Column="3" Text="{Binding Days, Mode=TwoWay}" Watermark="Days" Margin="2" />
            </Grid>
            <Button Content="Add duration" Command="{Binding AddToDateCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding AddResult}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Fixed duration conversion" FontWeight="SemiBold" />
            <TextBox Text="{Binding DurationValue, Mode=TwoWay}" Watermark="Duration value" />
            <ComboBox ItemsSource="{Binding DurationUnits}" SelectedItem="{Binding DurationFrom, Mode=TwoWay}" />
            <Button Content="Swap units" Command="{Binding SwapDurationUnitsCommand}" HorizontalAlignment="Left" />
            <ComboBox ItemsSource="{Binding DurationUnits}" SelectedItem="{Binding DurationTo, Mode=TwoWay}" />
            <Button Content="Convert duration" Command="{Binding ConvertDurationCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding DurationResult}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="FX">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Currency}" Margin="8" Spacing="10">
            <TextBlock Text="Currency Converter" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Optional network-enhanced module. CalcNova never embeds API keys; cached rates remain usable offline." Opacity="0.62" TextWrapping="Wrap" />
            <TextBox Text="{Binding Amount, Mode=TwoWay}" Watermark="Amount" />
            <TextBox Text="{Binding FromCurrency, Mode=TwoWay}" Watermark="From ISO code, e.g. USD" MaxLength="3" />
            <TextBox Text="{Binding ToCurrency, Mode=TwoWay}" Watermark="To ISO code, e.g. INR" MaxLength="3" />
            <WrapPanel>
              <Button Content="Convert" Command="{Binding ConvertCommand}" Margin="0,0,6,6" />
              <Button Content="Refresh rates" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Result}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Padding="10" CornerRadius="10"><TextBlock Text="{Binding RateStatus}" TextWrapping="Wrap" /></Border>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="History">
        <Grid DataContext="{Binding History}" Margin="8" RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Text="Calculation History" FontSize="21" FontWeight="SemiBold" />
          <StackPanel Grid.Row="1" Spacing="6">
            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Search" />
            <WrapPanel>
              <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
              <Button Content="Favorite" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,6,6" />
              <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
              <Button Content="Clear all" Command="{Binding ClearCommand}" Margin="0,0,6,6" />
            </WrapPanel>
          </StackPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4">
                  <TextBlock Text="{Binding Expression}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Result}" FontSize="17" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CreatedAt}" Opacity="0.52" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Settings}" Margin="8" Spacing="10">
            <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Theme" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" />
            <TextBlock Text="Angle unit" /><ComboBox ItemsSource="{Binding AngleUnits}" SelectedItem="{Binding AngleUnit, Mode=TwoWay}" />
            <TextBlock Text="Decimal precision (1–29)" /><TextBox Text="{Binding DecimalPrecision, Mode=TwoWay}" />
            <TextBlock Text="History limit (1–5000)" /><TextBox Text="{Binding HistoryLimit, Mode=TwoWay}" />
            <CheckBox Content="Enable history" IsChecked="{Binding HistoryEnabled, Mode=TwoWay}" />
            <CheckBox Content="Grouping separators" IsChecked="{Binding UseGroupingSeparators, Mode=TwoWay}" />
            <CheckBox Content="Haptics on supported mobile targets" IsChecked="{Binding HapticsEnabled, Mode=TwoWay}" />
            <CheckBox Content="Reduced motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
            <CheckBox Content="High contrast preference" IsChecked="{Binding HighContrast, Mode=TwoWay}" />
            <WrapPanel>
              <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,6" />
              <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding About}" Margin="8" Spacing="10">
            <TextBlock Text="{Binding ProjectName}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Tagline}" Opacity="0.68" />
            <TextBlock Text="Open-source calculator • Apache-2.0" />
            <Button Content="Open CalcNova repository" Command="{Binding OpenRepositoryCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Repository}" TextWrapping="Wrap" />
            <Button Content="Open GitHub profile" Command="{Binding OpenGitHubProfileCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding GitHubProfile}" TextWrapping="Wrap" />
            <Button Content="Buy Me a Coffee — @sanskarIN" Command="{Binding OpenBuyMeACoffeeCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding BuyMeACoffee}" TextWrapping="Wrap" />
            <TextBlock Text="Business" FontWeight="SemiBold" />
            <Button Content="sanskarin@outlook.in" Command="{Binding EmailBusinessCommand}" HorizontalAlignment="Left" />
            <Button Content="sanskarin.business@gmail.com" Command="{Binding EmailSecondaryBusinessCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="Support" FontWeight="SemiBold" />
            <Button Content="supportramsandesh@gmail.com" Command="{Binding EmailSupportCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="Support is optional and never required to use core CalcNova features." TextWrapping="Wrap" Opacity="0.65" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2"
               Text="Calculations stay local by default • github.com/sanskarIN/CalcNova"
               HorizontalAlignment="Center"
               Margin="0,8,0,0"
               Opacity="0.5" />
  </Grid>
</UserControl>