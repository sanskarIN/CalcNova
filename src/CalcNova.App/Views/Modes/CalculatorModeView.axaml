<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalcNova.App.Views.Modes.CalculatorModeView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="6" Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Standard + Scientific" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="Safe local expression evaluation" Opacity="0.62" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding AngleModeLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
      </Grid>

      <Border Padding="12" CornerRadius="14">
        <StackPanel Spacing="6">
          <TextBox Text="{Binding Expression, Mode=TwoWay}"
                   Watermark="Enter an expression"
                   FontSize="19"
                   HorizontalContentAlignment="Right" />
          <Button Command="{Binding UseResultCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalContentAlignment="Right">
            <TextBlock Text="{Binding Result}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Button>
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*">
        <Button Content="DEG" Command="{Binding SetAngleUnitCommand}" CommandParameter="Degrees" Margin="2" />
        <Button Grid.Column="1" Content="RAD" Command="{Binding SetAngleUnitCommand}" CommandParameter="Radians" Margin="2" />
        <Button Grid.Column="2" Content="GRAD" Command="{Binding SetAngleUnitCommand}" CommandParameter="Gradians" Margin="2" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*,*">
        <Button Content="MC" Command="{Binding MemoryClearCommand}" Margin="2" />
        <Button Grid.Column="1" Content="MR" Command="{Binding MemoryRecallCommand}" Margin="2" />
        <Button Grid.Column="2" Content="MS" Command="{Binding MemoryStoreCommand}" Margin="2" />
        <Button Grid.Column="3" Content="M+" Command="{Binding MemoryAddCommand}" Margin="2" />
        <Button Grid.Column="4" Content="M−" Command="{Binding MemorySubtractCommand}" Margin="2" />
      </Grid>
      <TextBlock Text="{Binding MemoryIndicator}" HorizontalAlignment="Right" Opacity="0.6" />

      <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto,Auto">
        <Button Classes="function-key" Content="sin" Command="{Binding AppendCommand}" CommandParameter="sin(" />
        <Button Classes="function-key" Grid.Column="1" Content="cos" Command="{Binding AppendCommand}" CommandParameter="cos(" />
        <Button Classes="function-key" Grid.Column="2" Content="tan" Command="{Binding AppendCommand}" CommandParameter="tan(" />
        <Button Classes="function-key" Grid.Column="3" Content="ln" Command="{Binding AppendCommand}" CommandParameter="ln(" />
        <Button Classes="function-key" Grid.Column="4" Content="log" Command="{Binding AppendCommand}" CommandParameter="log10(" />

        <Button Classes="function-key" Grid.Row="1" Content="√" Command="{Binding AppendCommand}" CommandParameter="sqrt(" />
        <Button Classes="function-key" Grid.Row="1" Grid.Column="1" Content="x²" Command="{Binding AppendCommand}" CommandParameter="sqr(" />
        <Button Classes="function-key" Grid.Row="1" Grid.Column="2" Content="xʸ" Command="{Binding AppendCommand}" CommandParameter="^" />
        <Button Classes="function-key" Grid.Row="1" Grid.Column="3" Content="π" Command="{Binding AppendCommand}" CommandParameter="pi" />
        <Button Classes="function-key" Grid.Row="1" Grid.Column="4" Content="e" Command="{Binding AppendCommand}" CommandParameter="e" />

        <Button Classes="function-key" Grid.Row="2" Content="(" Command="{Binding AppendCommand}" CommandParameter="(" />
        <Button Classes="function-key" Grid.Row="2" Grid.Column="1" Content=")" Command="{Binding AppendCommand}" CommandParameter=")" />
        <Button Classes="function-key" Grid.Row="2" Grid.Column="2" Content="%" Command="{Binding PercentageCommand}" />
        <Button Classes="function-key" Grid.Row="2" Grid.Column="3" Content="±" Command="{Binding ToggleSignCommand}" />
        <Button Classes="function-key" Grid.Row="2" Grid.Column="4" Content="1/x" Command="{Binding AppendCommand}" CommandParameter="reciprocal(" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <Button Classes="calc-key" Content="AC" Command="{Binding ClearCommand}" />
        <Button Classes="calc-key" Grid.Column="1" Content="⌫" Command="{Binding BackspaceCommand}" />
        <Button Classes="calc-key" Grid.Column="2" Content="÷" Command="{Binding AppendCommand}" CommandParameter="/" />
        <Button Classes="calc-key" Grid.Column="3" Content="×" Command="{Binding AppendCommand}" CommandParameter="*" />

        <Button Classes="calc-key" Grid.Row="1" Content="7" Command="{Binding AppendCommand}" CommandParameter="7" />
        <Button Classes="calc-key" Grid.Row="1" Grid.Column="1" Content="8" Command="{Binding AppendCommand}" CommandParameter="8" />
        <Button Classes="calc-key" Grid.Row="1" Grid.Column="2" Content="9" Command="{Binding AppendCommand}" CommandParameter="9" />
        <Button Classes="calc-key" Grid.Row="1" Grid.Column="3" Content="−" Command="{Binding AppendCommand}" CommandParameter="-" />

        <Button Classes="calc-key" Grid.Row="2" Content="4" Command="{Binding AppendCommand}" CommandParameter="4" />
        <Button Classes="calc-key" Grid.Row="2" Grid.Column="1" Content="5" Command="{Binding AppendCommand}" CommandParameter="5" />
        <Button Classes="calc-key" Grid.Row="2" Grid.Column="2" Content="6" Command="{Binding AppendCommand}" CommandParameter="6" />
        <Button Classes="calc-key" Grid.Row="2" Grid.Column="3" Content="+" Command="{Binding AppendCommand}" CommandParameter="+" />

        <Button Classes="calc-key" Grid.Row="3" Content="1" Command="{Binding AppendCommand}" CommandParameter="1" />
        <Button Classes="calc-key" Grid.Row="3" Grid.Column="1" Content="2" Command="{Binding AppendCommand}" CommandParameter="2" />
        <Button Classes="calc-key" Grid.Row="3" Grid.Column="2" Content="3" Command="{Binding AppendCommand}" CommandParameter="3" />
        <Button Classes="calc-key" Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Content="=" Command="{Binding EvaluateCommand}" />

        <Button Classes="calc-key" Grid.Row="4" Grid.ColumnSpan="2" Content="0" Command="{Binding AppendCommand}" CommandParameter="0" />
        <Button Classes="calc-key" Grid.Row="4" Grid.Column="2" Content="." Command="{Binding AppendCommand}" CommandParameter="." />
      </Grid>

      <WrapPanel HorizontalAlignment="Right">
        <Button Content="Copy result" Click="CopyResult" Margin="0,0,6,6" />
        <Button Content="Copy expression" Click="CopyExpression" Margin="0,0,6,6" />
        <Button Content="Paste expression" Click="PasteExpression" Margin="0,0,6,6" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
