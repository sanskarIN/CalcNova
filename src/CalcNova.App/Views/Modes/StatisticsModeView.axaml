<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CalcNova.App.Views.Modes.StatisticsModeView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="10">
      <TextBlock Text="Statistics" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="Paste comma, whitespace, semicolon, or newline-separated finite values." TextWrapping="Wrap" Opacity="0.62" />
      <TextBox Text="{Binding DatasetText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" />
      <Button Content="Analyze dataset" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Left" />
      <Border Padding="12" CornerRadius="12">
        <TextBlock Text="{Binding Summary}" FontSize="16" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
