<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>in.sanskar.calcnova</id>
  <name>CalcNova</name>
  <summary>Fast, precise, privacy-first cross-platform calculator</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <description>
    <p>CalcNova is a complete open-source local-first calculator with standard, scientific, exact-rational, engineering-notation, programmer, Unicode, conversion, statistics, equations, matrices, graphing, history, settings, keyboard, accessibility, and cross-platform workflows.</p>
  </description>
  <!-- CalcNova 1.0.0 is the project's first release. The 2.8 and 2.9 numbers that preceded it
       were pre-release development checkpoints: no tag and no published artifact ever existed
       for any of them. Listing them here as stable releases would have told software centres
       that a version newer than 1.0.0 was available, because every version comparator ranks
       2.9.7 above 1.0.0. The development record is kept in CHANGELOG.md and docs/history/. -->
  <releases>
    <release version="1.0.0" date="2026-09-17" type="stable">
      <description>
        <p>CalcNova 1.0.0 is the first release: a complete local-first calculator covering standard, scientific, exact-rational, engineering-notation, programmer, Unicode, conversion, statistics, equations, matrices, graphing, currency, history and settings workflows across Desktop, Browser, Android and iOS.</p>
      </description>
    </release>
  </releases>
  <launchable type="desktop-id">in.sanskar.calcnova.desktop</launchable>
  <url type="homepage">https://github.com/sanskarIN/CalcNova</url>
  <url type="bugtracker">https://github.com/sanskarIN/CalcNova/issues</url>
  <url type="donation">https://buymeacoffee.com/sanskarIN</url>
  <categories>
    <category>Utility</category>
    <category>Education</category>
  </categories>
  <provides>
    <binary>CalcNova.Desktop</binary>
  </provides>
</component>
