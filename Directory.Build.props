<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>

    <!-- Public/product release identity. 2.8.03 is the user-facing version requested for CalcNova. -->
    <ProductDisplayVersion>2.8.03</ProductDisplayVersion>
    <!-- NuGet/MSBuild package versions follow SemVer 2.0, where leading zero patch values are invalid. -->
    <Version>2.8.3</Version>
    <VersionPrefix>2.8.3</VersionPrefix>
    <PackageVersion>2.8.3</PackageVersion>
    <AssemblyVersion>2.8.3.0</AssemblyVersion>
    <FileVersion>2.8.3.0</FileVersion>
    <InformationalVersion>2.8.03</InformationalVersion>

    <Authors>Sanskar</Authors>
    <RepositoryUrl>https://github.com/sanskarIN/CalcNova</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
